# Digimax Budget Hub - Environment Variables Template
# Copy this file to .env.local and fill in your values

# ========================================
# Authentication
# ========================================
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-key-here

# Base URL for NextAuth callbacks
NEXTAUTH_URL=http://localhost:3000

# ========================================
# Database
# ========================================
# SQLite (Development)
DATABASE_URL="file:./prisma/dev.db"

# PostgreSQL (Production example)
# DATABASE_URL="postgresql://user:password@localhost:5432/digimax_budget?schema=public"

# ========================================
# Optional: External Services
# ========================================
# EMAIL_SERVER=smtp://user:password@smtp.example.com:587
# EMAIL_FROM=noreply@example.com

# ========================================
# Development Notes
# ========================================
# - Never commit .env or .env.local files to version control
# - For demo credentials, see: docs/DEMO.md
# - For security guidelines, see: ../SECURITY.md
